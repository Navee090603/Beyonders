<header class="admin-topbar navbar navbar-expand border-bottom">
    <div class="container-fluid d-flex align-items-center">

        <!-- Full-width Search Bar -->
        <form class="flex-grow-1 mx-2" method="get"
              action="@Url.Action("Index","Orders", new { area = "" })">
            <div class="input-group input-group-sm">
                <input class="form-control border-0 shadow-sm"
                       style="border-radius:20px 0 0 20px;"
                       name="q" placeholder=" Search orders, products, customers" />
                <div class="input-group-append">
                    <button class="btn btn-light shadow-sm"
                            style="border-radius:0 20px 20px 0;" type="submit">
                        <i class="fa fa-search text-secondary"></i>
                    </button>
                </div>
            </div>
        </form>

        <!-- Notifications + Profile -->
        <ul class="nav align-items-center">
            <!-- Notifications -->
            <li class="nav-item dropdown mr-3">
                <a class="nav-link dropdown-toggle text-white p-2"
                   href="#" id="notifDropdown" data-toggle="dropdown">
                    <i class="fa fa-bell"></i>
                    <span class="badge badge-light badge-pill"
                          style="color:#c084fc;">2</span>
                </a>
                <div class="dropdown-menu dropdown-menu-right p-2"
                     aria-labelledby="notifDropdown" style="min-width:260px; max-width:90vw;">
                    <div class="small text-muted">Notifications</div>
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-item small" href="#">New order received (#12345)</a>
                    <a class="dropdown-item small" href="#">Tokens Raised</a>
                </div>
            </li>

            <!-- Profile -->
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle text-white p-2"
                   href="#" id="profileDropdown" data-toggle="dropdown">
                    <i class="fa fa-user-circle"></i> Admin
                </a>
                <div class="dropdown-menu dropdown-menu-right"
                     aria-labelledby="profileDropdown">
                    <a class="dropdown-item" href="#">Profile</a>
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-item" href="#">Sign out</a>
                </div>
            </li>
        </ul>
    </div>
</header>

<style>
    .admin-topbar {
        background: linear-gradient(90deg, #d8b4fe, #fcb1c8); /* pastel lavender → pastel pink */
        color: #fff;
        padding: 10px 15px;
    }

        .admin-topbar .nav-link:hover {
            color: #000 !important;
            background: rgba(255, 255, 255, 0.25);
            border-radius: 6px;
        }

    .input-group-sm .form-control {
        font-size: 0.9rem;
    }
</style>